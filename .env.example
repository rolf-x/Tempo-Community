# Tempo's settings. Names only: never commit real values.
# Local dev: copy this file to .env.local and fill it in. Hosting: add the same names in Vercel → Settings → Environment Variables.
# scripts/setup/vercel-env.mjs sets all of them in Vercel for you (see README → Self-hosting).

# ── Browser (built into the page; none of these are secret) ──────────────────────────────────────────────
# Your site's address, no trailing slash, e.g. https://your-tempo.vercel.app. Fills the link-preview tags in index.html.
VITE_SITE_URL=
# Where people ask to delete their account or workspace (shown on the Privacy page). Optional.
VITE_CONTACT_EMAIL=
# Your Supabase project URL, the plain https://<ref>.supabase.co form (Settings → API).
VITE_SUPABASE_URL=
# Your Supabase project's anon (public) key (Settings → API).
VITE_SUPABASE_ANON_KEY=
# Your GitHub App's slug, the last part of https://github.com/apps/<slug>. Required in production builds.
VITE_GITHUB_APP_SLUG=
# How AI reaches Tempo: legacy (your own API key) | both (Claude through MCP, or your own key) | mcp (Claude only).
VITE_AI_MODE=both
# Optional, legacy: a classic GitHub OAuth app's client ID. Leave empty when you use a GitHub App.
VITE_GITHUB_CLIENT_ID=

# ── Server (Vercel functions in api/; keep these secret) ────────────────────────────────────────────────
# Your GitHub App's numeric App ID.
GITHUB_APP_ID=
# Your GitHub App's client ID (also goes into Supabase → Authentication → Providers → GitHub).
GITHUB_APP_CLIENT_ID=
# Your GitHub App's client secret (also goes into Supabase's GitHub provider).
GITHUB_APP_CLIENT_SECRET=
# Your GitHub App's private key: the whole .pem, or one line with \n for each line break.
GITHUB_APP_PRIVATE_KEY=
# The webhook secret you gave the GitHub App. Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Encrypts the GitHub sign-in cookie: 32 random bytes in base64. Generate: openssl rand -base64 32
GITHUB_TOKEN_KEY=
# Lets the server save repo facts after a push. Generate: openssl rand -base64 48, then store its SHA-256 in the database (README).
TEMPO_SERVER_KEY=
# Guards the daily refresh job; Vercel Cron sends it. Generate: openssl rand -hex 32
CRON_SECRET=
# Optional: the server falls back to VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY when these are empty.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Local dev only ──────────────────────────────────────────────────────────────────────────────────────
# 1 = every AI call goes to the claude CLI on your computer (claude -p), never to a paid API.
VITE_AI_LOCAL_ONLY=
